# Copy to .env and fill in values
# Never commit .env to git

# ── Local dev ─────────────────────────────────────────────────────────────────
ENV=local

# DynamoDB — point at local instance when developing
DYNAMODB_ENDPOINT=http://localhost:8001
DYNAMODB_TABLE=jamesbrannon-content

# AWS region (even for local, boto3 requires one)
AWS_REGION=eu-west-2

# Fake credentials for local DynamoDB (moto/DynamoDB Local accept any value)
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# Admin UI credentials — change before deploying to production
ADMIN_USER=admin
ADMIN_PASS=changeme

# Session signing key — generate a strong random string for production
# python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-change-in-production

# ── Google OAuth (optional — set to enable Google Sign-in, leave blank for password login) ──
# Register at https://console.cloud.google.com/ → APIs & Services → Credentials
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret
# GOOGLE_ALLOWED_DOMAINS=jamesbrannon.co.uk
# OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback

# ── S3 media storage ───────────────────────────────────────────────────────────
# Local dev uses MinIO (started by start.sh via Docker).
# Leave S3_BUCKET blank to fall back to local filesystem (no Docker required).
S3_BUCKET=jamesbrannon-media
S3_BUCKET_REGION=eu-west-2

# MinIO endpoint for local dev — remove in production
S3_ENDPOINT_URL=http://localhost:9000

# Public base URL for stored files — MinIO serves at this path locally
# In production: https://media.jamesbrannon.co.uk
S3_PUBLIC_BASE_URL=http://localhost:9000/jamesbrannon-media

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins. Vite dev server is allowed by default.
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Ollama (optional — AI excerpt generation) ──────────────────────────────────
# Install: brew install ollama && ollama pull llama3.2 && ollama serve
# Leave unset if you don't want auto-generated post excerpts
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2
