# Copy to .env and fill in values
# Never commit .env to git

# ── Local dev ─────────────────────────────────────────────────────────────────
ENV=local

# DynamoDB — point at local instance when developing
DYNAMODB_ENDPOINT=http://localhost:8001
DYNAMODB_TABLE=jamesbrannon-content

# AWS region (even for local, boto3 requires one)
AWS_REGION=eu-west-2

# Fake credentials for local DynamoDB (moto/DynamoDB Local accept any value)
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# Admin UI credentials — change before deploying to production
ADMIN_USER=admin
ADMIN_PASS=changeme

# Session signing key — generate a strong random string for production
# python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-change-in-production

# ── S3 media storage (optional — leave blank for local filesystem) ─────────────
# Set these to enable S3 upload for images in production
S3_BUCKET=
S3_BUCKET_REGION=eu-west-2
