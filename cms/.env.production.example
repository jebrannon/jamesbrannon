# Production environment template — commit this file, never commit real values.
# In production, inject these via AWS Secrets Manager or SSM Parameter Store.

ENV=production

# DynamoDB
DYNAMODB_TABLE=jamesbrannon-content
AWS_REGION=eu-west-2
# Do NOT set DYNAMODB_ENDPOINT — absence signals production mode

# Google OAuth — recommended for production (ADMIN_USER/ADMIN_PASS not required when enabled)
GOOGLE_CLIENT_ID=<your-client-id.apps.googleusercontent.com>
GOOGLE_CLIENT_SECRET=<set-in-ssm>
GOOGLE_ALLOWED_DOMAINS=jamesbrannon.co.uk
OAUTH_REDIRECT_URI=https://<your-api-gateway-domain>/auth/callback

# Admin credentials — only required if NOT using Google OAuth
# ADMIN_USER=<set-in-ssm>
# ADMIN_PASS=<set-in-ssm>

# Session signing key — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=<generate-with-secrets.token_hex(32)>

# CORS — restrict to your CloudFront domain
CORS_ORIGINS=https://jamesbrannon.co.uk

# S3 media storage
S3_BUCKET=jamesbrannon-media
S3_BUCKET_REGION=eu-west-2
# S3_ENDPOINT_URL — do NOT set in production (absence signals real AWS S3)
# S3_PUBLIC_BASE_URL — do NOT set in production (defaults to AWS S3 URL pattern)
